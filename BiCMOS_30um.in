go athena

# ---------------------------
# Mesh (refined near surface and device areas)
# ---------------------------
line x loc=0.0   spac=0.5
line x loc=2.0   spac=0.05   ;# NPN region left edge
line x loc=6.0   spac=0.02
line x loc=10.0  spac=0.05
line x loc=12.0  spac=0.05   ;# CMOS region start
line x loc=16.0  spac=0.02
line x loc=20.0  spac=0.05
line x loc=30.0  spac=0.5

line y loc=0.0   spac=0.02   ;# surface fine mesh
line y loc=0.2   spac=0.02
line y loc=0.5   spac=0.05
line y loc=1.0   spac=0.1
line y loc=2.0   spac=0.2
line y loc=5.0   spac=0.5

# ---------------------------
# Initialize substrate
# ---------------------------
init silicon orientation=100 c.boron=1e15 ;#Boron is P-type

# -----------------------------------------------
# BURIED N+ LAYER FOR NPN COLLECTER (deep, heavy)
#		Fom x=2um to x=10um
# -----------------------------------------------

deposit oxide thick=1

# MASK 1
etch start x=2 y=-1
etch cont x=10 y=-1
etch cont x=10 y=0
etch done x =2 y=0

implant arsenic dose=3.0e14 energy=120 tilt=7
diffus temp=1100 time=45 minutes  ;# drive-in to form buried layer

etch oxide all

structure outfile = buried_n.str
save outfile = buried_n.str
tonyplot buried_n.str

#--------------------------------------------------------
#			Epitaxial Growth
#--------------------------------------------------------
epitaxy time=40 minutes temp=1100 thickness=2 c.boron=1e15 

save outfile = epi_silicon.str
tonyplot epi_silicon.str


etch oxide all

#-------------------------------------------------------------------
#	Double Mask to etch Collector Sinker and N-Well Simultaneously
#	*Dose of Sinker >> Dose of N-Well*
#-------------------------------------------------------------------
deposit oxide thick = 1

etch start x=8.5 y=-3 ;# Collector Window
etch cont x=10 y=-3
etch cont x=10 y=-2
etch done x =8.5 y=-2

implant phosphorus dose=5e14 energy=180
diffuse temp= 1100 time = 120

save outfile = collector_window.str
tonyplot collector_window.str

etch oxide all

deposit oxide thick = 1

etch start x=15 y=-3 ;# N-well Window
etch cont x=20 y=-3
etch cont x=20 y=-2.0
etch done x =15 y=-2.0

implant phosphorus dose=3e13 energy=150 ;# Affects PMOS Vth
diffuse temp= 1100 time = 100

save outfile = CollNwell.str
tonyplot CollNwell.str

etch oxide all

#---------------------------------
# Base Formation
#---------------------------------
deposit oxide thick = 0.5

etch start x=3 y=-2.5
etch cont x=5 y=-2.5
etch cont x=5 y=-2
etch done x =3 y=-2

implant boron dose=5e15 energy=40 tilt=7
diffuse temp=950 time=20

save outfile = base.str
tonyplot base.str
etch oxide all

# --------------------------------------------------------
# 			Emitter Formation - Before S/D
# This is the smallest junction in the BJT
# An N+ contact region is diffused for better connectivity
# --------------------------------------------------------
# Emitter mask
deposit oxide thick = 0.5

etch start x=1 y=-2.5
etch cont x=2 y=-2.5
etch cont x=2 y=-2
etch done x=1 y=-2

implant arsenic dose=2e15 energy=50 tilt=7
diffuse temp=950 time=5  ;# Quick anneal, low temp, short time

save outfile = emitter.str
tonyplot emitter.str

etch oxide all

# ---------------------------
# 2. GATE OXIDE & POLY GATE
# ---------------------------

# Grow thin gate oxide

deposit oxide thick=0.3

# Deposit polysilicon for gates
deposit poly thick=0.2 divisions=10	;# 2.5um thick

save outfile = polysilic.str
tonyplot polysilic.str


# Pattern gates:
# PMOS gate in N-well region (x=15-17um & x=18-20um)
etch poly start x=0 y=-2.5
etch cont x=17.0 y=-2.5
etch cont x=17.0 y=-2.3
etch done x=0 y=-2.3

etch poly start x=18.0 y=-2.5
etch cont x=26.0 y=-2.5
etch cont x=26.0 y=-2.3
etch done x=18.0 y=-2.3

etch poly start x=27.0 y=-2.5
etch cont x=30.0 y=-2.5
etch cont x=30.0 y=-2.3
etch done x=27.0 y=-2.3

save outfile = gates.str
tonyplot gates.str

# oxide too thin, more needed
#deposit oxide thick=0.3 ;# 2.5um thick

# etch PR from PMOS S/D surfaces



etch oxide start x=15.0 y=-2.3
etch cont x=17.0 y=-2.3
etch cont x=17.0 y=-2.0
etch done x=15.0 y=-2.0

etch oxide start x=18.0 y=-2.3
etch cont x=20.0 y=-2.3
etch cont x=20.0 y=-2.0
etch done x=18.0 y=-2.0

save outfile=pmos_gate.str
tonyplot pmos_gate.str


#---------------------------------------------------------
#			PMOS S/D
# 
#---------------------------------------------------------
#Deposit oxide and pattern for PMOS S/D only

implant boron dose=4e15 energy=40 tilt=7  ;# PMOS S/D only

save outfile = pmos_SD.str
tonyplot pmos_SD.str


etch oxide
save outfile = pmos_etch.str
tonyplot pmos_etch.str

# Source side 
deposit oxide thick=0.3	;# Passivation Layer

save outfile = passivation.str
tonyplot passivation.str

etch oxide start x=9.25 y=-2.3   ;# Etch Collector contact
etch cont x=9.75 y=-2.3
etch cont x=9.75 y=-2.0
etch done x=9.25 y=-2.0

etch oxide start x=24.3 y=-2.3 ;# Etch Source
etch cont x=25.69 y=-2.3
etch cont x=25.69 y=-2.0
etch done x=24.3 y=-2.0


etch oxide start x=27.33 y=-2.3   ;# Etch Drain
etch cont x=28.4 y=-2.3
etch cont x=28.4 y=-2.0
etch done x=27.33 y=-2.0


save outfile = nmos_etch.str
tonyplot nmos_etch.str

#------------------------------------
# Deposit N type material

implant arsenic dose=5e18 energy=45 ;#Very low diffusivity; shallow junctions; tilt not preferred

# 3. Single activation for both
diffuse temp=950 time=12


# ---------------------------
# Save structure for ATLAS device simulation

# ---------------------------
structure outfile = basic_bicmos_30um.str

save outfile=basic_bicmos_30um.str
tonyplot basic_bicmos_30um.str


deposit oxide thick=0.1
save outfile = basic_bicmos_etched.str
tonyplot basic_bicmos_etched.str

# Metallization


etch oxide start x=1.3 y=-2.4   ;# Etch Emitter Contact
etch cont x=1.6 y=-2.4
etch cont x=1.6 y=-2.0
etch done x=1.3 y=-2.0

etch oxide start x=3.75 y=-2.4   ;# Etch Base Contact
etch cont x=4.25 y=-2.4
etch cont x=4.25 y=-2.0
etch done x=3.75 y=-2.0

etch oxide start x=9.25 y=-2.1   ;# Etch Collector Contact
etch cont x=9.75 y=-2.1
etch cont x=9.75 y=-2.0
etch done x=9.25 y=-2.0

save outfile = bjt_metal.str
tonyplot bjt_metal.str



etch oxide start x=15.5 y=-2.4   ;# Etch PMOS S Contact
etch cont x=16.4 y=-2.4
etch cont x=16.4 y=-2.0
etch done x=15.5 y=-2.0

etch oxide start x=17.3 y=-2.9   ;# Etch PMOS Gate Contact
etch cont x=17.7 y=-2.9
etch cont x=17.7 y=-2.5
etch done x=17.3 y=-2.5

etch oxide start x=18.75 y=-2.4   ;# Etch PMOS D Contact
etch cont x=19.5 y=-2.4
etch cont x=19.5 y=-2.0
etch done x=18.75 y=-2.0


etch oxide start x=24.75 y=-2.1   ;# Etch NMOS D Contact
etch cont x=25.3 y=-2.1
etch cont x=25.3 y=-2.0
etch done x=24.75 y=-2.0

etch oxide start x=26.3 y=-2.9   ;# Etch NMOS Gate Contact
etch cont x=26.7 y=-2.9
etch cont x=26.7 y=-2.5
etch done x=26.3 y=-2.5

etch oxide start x=27.65 y=-2.1   ;# Etch NMOS S Contact
etch cont x=28.0 y=-2.1
etch cont x=28.0 y=-2.0
etch done x=27.65 y=-2.0

save outfile = cmos_metal_etch.str
tonyplot cmos_metal_etch.str


# 
deposit aluminum thick=0.5 
save outfile = bicmos_finished.str
tonyplot bicmos_finished.str

quit
