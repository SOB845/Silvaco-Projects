go athena

# ---------------------------
# Mesh (refined near surface and device areas)
# ---------------------------
line x loc=0.0   spac=0.5
line x loc=2.0   spac=0.05   ;# NPN region left edge
line x loc=6.0   spac=0.02
line x loc=10.0  spac=0.05
line x loc=12.0  spac=0.05   ;# CMOS region start
line x loc=16.0  spac=0.02
line x loc=20.0  spac=0.05
line x loc=30.0  spac=0.5

line y loc=0.0   spac=0.02   ;# surface fine mesh
line y loc=0.2   spac=0.02
line y loc=0.5   spac=0.05
line y loc=1.0   spac=0.1
line y loc=2.0   spac=0.2
line y loc=5.0   spac=0.5

# ---------------------------
# Initialize substrate
# ---------------------------
init silicon orientation=100 c.boron=1e15 ;#Boron is P-type

# -----------------------------------------------
# BURIED N+ LAYER FOR NPN COLLECTER (deep, heavy)
#		Fom x=2um to x=10um
# -----------------------------------------------

deposit oxide thick=1

# MASK 1
etch start x=2 y=-1
etch cont x=10 y=-1
etch cont x=10 y=0
etch done x =2 y=0

implant arsenic dose=3.0e14 energy=120 tilt=7
diffus temp=1100 time=45 minutes  ;# drive-in to form buried layer

etch oxide all

save outfile = buried_n.str
#tonyplot buried_n.str

#--------------------------------------------------------
#			Epitaxial Growth
#--------------------------------------------------------
epitaxy time=40 minutes temp=1100 thickness=2 c.boron=1e15 

save outfile = epi_silicon.str
tonyplot epi_silicon.str


etch oxide all

#-------------------------------------------------------------------
#	Double Mask to etch Collector Sinker and N-Well Simultaneously
#	*Dose of Sinker >> Dose of N-Well*
#-------------------------------------------------------------------
deposit oxide thick = 1

etch start x=8.5 y=-3 ;# Collector Window
etch cont x=10 y=-3
etch cont x=10 y=-2
etch done x =8.5 y=-2

implant phosphorus dose=5e14 energy=180
diffuse temp= 1100 time = 120

etch oxide all

deposit oxide thick = 1

etch start x=15 y=-3 ;# N-well Window
etch cont x=20 y=-3
etch cont x=20 y=-2.0
etch done x =15 y=-2.0

implant phosphorus dose=3e14 energy=150 ;# Affects PMOS Vt
diffuse temp= 1100 time = 100

save outfile = CollNwell.str
tonyplot CollNwell.str

etch oxide all

# Base Formation
deposit oxide thick = 0.5

etch start x=2.5 y=-2.5
etch cont x=8.5 y=-2.5
etch cont x=8.5 y=-2
etch done x =2.5 y=-2

implant boron dose=5e15 energy=40 tilt=7
diffuse temp=950 time=25

save outfile = base.str
tonyplot base.str



# ---------------------------
# 2. GATE OXIDE & POLY GATE
# ---------------------------
# Grow thin gate oxide
#diffuse temp=900 time=20 dryo2  which yields ~20nm gate oxide failed due to computational incapability

# Deposit polysilicon for gates
deposit poly thick=0.3 divisions=10

save outfile = polygate.str
tonyplot polygate.str


# --------------------------------------------------------
# 			Emitter Formation
# This is the smallest junction in the BJT
# An N+ contact region is diffused for better connectivity
# --------------------------------------------------------
deposit oxide thick=0.5
# Emitter mask
etch start x=4.5 y=-2.5
etch cont x=6.5 y=-2.5
etch cont x=6.5 y=-2
etch done x=4.5 y=-2

implant arsenic dose=2e15 energy=50
diffuse temp=950 time=5  ;# Quick anneal

save outfile = emitter.str
tonyplot emitter.str

etch oxide all




#---------------------------------------------------------
#			N-WELL FOR PMOS
# From x=15um to 20um
#---------------------------------------------------------

deposit oxide thick=0.70

# MASK 2
etch start x=15 y=-2.70
etch cont x=20 y=-2.70
etch cont x=20 y=-2.0
etch done x =15 y=-2.0

implant phosphorus dose=2e16 energy=70 tilt=7
diffuse temp= 1100 time=1 hours

save outfile = NWELL.str
tonyplot NWELL.str

etch start x=23 y=-2.70
etch cont x=28 y=-2.70
etch cont x=28 y=-2.0
etch done x=23 y=-2.0




# ---------------------------
# Save structure for ATLAS device simulation
# ---------------------------
structure outfile=basic_bicmos_30um.str

quit
